-- Third-party cabal external commands, the `cabal-<cmd>` executables that
-- `cabal <cmd>` runs when it finds them on the PATH, built against the
-- in-tree libraries so that they can be run and tested here with the in-tree
-- cabal. See `make external-commands`.
import: project-cabal/ghc-options.config
import: project-cabal/ghc-latest.config
import: project-cabal/pkgs/cabal.config
import: project-cabal/pkgs/install.config
-- The tests group only so that `build all --enable-tests --dry-run` resolves,
-- as every project here must; nothing in it is built by default.
import: project-cabal/pkgs/tests.config
import: project-cabal/constraints.config

-- Not every tool builds against the in-tree libraries. Those that do not are
-- kept here, to retry when a release of theirs catches up, but left out of the
-- Makefile's EXTERNAL_COMMANDS:
--  * cabal-fmt-0.1.12, cabal-gild-1.8.4.2 and cabal-plan-bounds-0.1.6.1 import
--    Distribution.Compat.Newtype, which Cabal-syntax 3.19 no longer has
--    (PR #12126).
--  * cabal-bounds-2.7.0 builds on cabal-lenses-0.15.0, which still passes
--    CondTree the constraints parameter that PR #11626 removed.
--  * cabal-hoogle-3.16.0.0 passes a Verbosity where Cabal 3.19 takes
--    VerbosityFlags (PR #11077) and imports Distribution.Make, decommissioned
--    with build-type: Make (PR #11894).
extra-packages:
    cabal-plan
  , cabal-fmt
  , cabal-gild
  , cabal-add
  , cabal-bounds
  , cabal-hoogle
  , cabal-plan-bounds
  , hpack-dhall

-- Their bounds stop at the last released Cabal; the in-tree one is newer.
allow-newer:
    cabal-plan:*
  , cabal-fmt:*
  , cabal-gild:*
  , cabal-add:*
  , cabal-hoogle:*
  , cabal-plan-bounds:*
-- hpack, under hpack-dhall, is the one that links Cabal.
  , hpack:*
-- dhall-json-1.7.12 caps aeson below 2.2, and the aeson-2.1 that leaves wants
-- a th-abstraction that no longer compiles with GHC 9.14.
  , dhall-json:aeson

constraints: aeson >=2.2

optimization: False
tests: False
