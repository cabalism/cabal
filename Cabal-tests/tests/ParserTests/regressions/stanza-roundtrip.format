cabal-version: 3.0
name:          stanza-roundtrip
version:       0
license:       MIT
maintainer:    none@example.com
synopsis:      libraries carrying each stanza value
description:
    Exercises pretty-printing and re-parsing of the stanza field.

category:      Tests

library
    exposed-modules:  Foo
    default-language: Haskell2010
    build-depends:    base >=4.9 && <5

library test-helper
    exposed-modules:  Bar
    stanza:           test
    default-language: Haskell2010
    build-depends:    base >=4.9 && <5

library bench-helper
    exposed-modules:  Baz
    stanza:           bench
    default-language: Haskell2010
    build-depends:    base >=4.9 && <5

library both-helper
    exposed-modules:  Qux
    stanza:           test, bench
    default-language: Haskell2010
    build-depends:    base >=4.9 && <5

library plain-helper
    exposed-modules:  Quux
    default-language: Haskell2010
    build-depends:    base >=4.9 && <5

test-suite spec
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    default-language: Haskell2010
    build-depends:
        base >=4.9 && <5,
        stanza-roundtrip:test-helper

benchmark bench
    type:             exitcode-stdio-1.0
    main-is:          Bench.hs
    default-language: Haskell2010
    build-depends:
        base >=4.9 && <5,
        stanza-roundtrip:bench-helper
