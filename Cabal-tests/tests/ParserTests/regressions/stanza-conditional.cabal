cabal-version: 3.0
name:          stanza-conditional
version:       0
synopsis:      the stanza field set inside a conditional
description:   The stanza has to be known before conditions are resolved. This description is deliberately longer than the synopsis so that the golden output isolates the stanza check.
category:      Tests
license:       MIT
maintainer:    none@example.com

flag fancy
  default: False
  manual:  True

library helper
  default-language: Haskell2010
  build-depends:    base >=4.9 && <5
  exposed-modules:  Bar
  if flag(fancy)
    stanza: test

test-suite spec
  default-language: Haskell2010
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  build-depends:    base >=4.9 && <5, stanza-conditional:helper
