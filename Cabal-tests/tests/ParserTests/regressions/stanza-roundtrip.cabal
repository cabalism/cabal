cabal-version: 3.0
name:          stanza-roundtrip
version:       0
synopsis:      libraries carrying each stanza value
description:   Exercises pretty-printing and re-parsing of the stanza field.
category:      Tests
license:       MIT
maintainer:    none@example.com

library
  default-language: Haskell2010
  build-depends:    base >=4.9 && <5
  exposed-modules:  Foo

library test-helper
  default-language: Haskell2010
  stanza:           test
  build-depends:    base >=4.9 && <5
  exposed-modules:  Bar

library bench-helper
  default-language: Haskell2010
  stanza:           bench
  build-depends:    base >=4.9 && <5
  exposed-modules:  Baz

library both-helper
  default-language: Haskell2010
  stanza:           test, bench
  build-depends:    base >=4.9 && <5
  exposed-modules:  Qux

library plain-helper
  default-language: Haskell2010
  build-depends:    base >=4.9 && <5
  exposed-modules:  Quux

test-suite spec
  default-language: Haskell2010
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  build-depends:    base >=4.9 && <5, stanza-roundtrip:test-helper

benchmark bench
  default-language: Haskell2010
  type:             exitcode-stdio-1.0
  main-is:          Bench.hs
  build-depends:    base >=4.9 && <5, stanza-roundtrip:bench-helper
