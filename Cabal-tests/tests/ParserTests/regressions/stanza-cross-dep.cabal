cabal-version: 3.0
name:          stanza-cross-dep
version:       0
synopsis:      a component outside a stanza depending on a library in one
description:   The executable depends on a test-scoped library. This description is deliberately longer than the synopsis so that the golden output isolates the stanza check.
category:      Tests
license:       MIT
maintainer:    none@example.com

library
  default-language: Haskell2010
  build-depends:    base >=4.9 && <5
  exposed-modules:  Foo

library helper
  default-language: Haskell2010
  stanza:           test
  build-depends:    base >=4.9 && <5
  exposed-modules:  Bar

executable prog
  default-language: Haskell2010
  main-is:          Main.hs
  build-depends:    base >=4.9 && <5, stanza-cross-dep:helper

test-suite spec
  default-language: Haskell2010
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  build-depends:    base >=4.9 && <5, stanza-cross-dep:helper
