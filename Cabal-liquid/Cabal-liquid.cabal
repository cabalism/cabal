cabal-version: 3.0
name:          Cabal-liquid
version:       3.19.0.0
synopsis:      LiquidHaskell verification of invariants in the Cabal libraries
description:
  This package is not released.  It compiles selected modules of the Cabal
  libraries a second time, from their own source files, with the LiquidHaskell
  plugin enabled so that the refinement type specifications written in those
  modules are checked.  Build it with @cabal.liquid.project@, see
  @Cabal-liquid/README.md@.
category:      Testing
build-type:    Simple

common liquid
  default-language:   GHC2021
  default-extensions: NoImportQualifiedPost
  ghc-options:
    -Wall
    -fplugin=LiquidHaskell

  build-depends:
    , base
    , Cabal-syntax   ^>=3.19.0.0
    , liquidhaskell  ^>=0.9.14.1

-- Specifications for library modules that are not verified themselves.
-- LiquidHaskell finds a module @M_LHAssumptions@ by name when a verified
-- module imports @M@ and @M@ carries no specifications of its own.  These
-- specifications are trusted, not checked.
library assumptions
  import:          liquid
  hs-source-dirs:  assumptions
  exposed-modules:
    Distribution.Compat.Prelude_LHAssumptions
    Distribution.Types.Version_LHAssumptions
    Distribution.Types.VersionRange.Internal_LHAssumptions

-- Each module under verification is a symbolic link to the module of the same
-- name in the library that owns it.  Listing a module puts it under
-- verification; its imports still come from the compiled library.
--
-- One sub-library per verified module.  GHC prefers a module found on the
-- source path over the same module from a package, so two verified modules
-- sharing a component would see each other's copy instead of the library's,
-- and the assumptions about the library's copy would no longer apply.
library intervals
  import:         liquid
  hs-source-dirs: intervals
  build-depends:  Cabal-liquid:assumptions
  other-modules:
    Distribution.Types.VersionInterval

-- Not built yet: with the pinned liquidhaskell the field of a newtype cannot
-- be related to the set it was built from (liquidhaskell issue 2766), so no
-- specification mentioning the set can be proved.  With release 0.9.14.1.1,
-- which still treated a newtype as its representation, the Data deriving
-- cut and the specifications written against the set itself, the module
-- verified and deliberate bugs were caught.  Flip buildable to try it.
library nonemptyset
  import:         liquid
  buildable:      False
  hs-source-dirs: nonemptyset
  build-depends:
    , Cabal-liquid:assumptions
    , containers
    , deepseq
  other-modules:
    Distribution.Compat.NonEmptySet

-- Needs liquidhaskell pull request 2700, which stops checking derived
-- instances and default methods.  Without it, derived Generic instances
-- cannot be encoded, the auxiliary bindings of derived Data instances are
-- inferred false and make every specification hold vacuously, and the
-- Generic-default methods of the Binary and Structured instances overflow
-- the stack in liquid-fixpoint.
library version
  import:         liquid
  hs-source-dirs: version
  build-depends:
    , Cabal-liquid:assumptions
    , pretty
  other-modules:
    Distribution.Types.Version

library generic
  import:         liquid
  hs-source-dirs: generic
  build-depends:
    , bytestring
    , Cabal-liquid:assumptions
    , containers
    , directory
    , filepath
    , text
  other-modules:
    Distribution.Utils.Generic

-- The sequence operations union, intersection and relaxLastInterval are not
-- checked, see the note at the top of the module; the rest is.
library legacy
  import:         liquid
  hs-source-dirs: legacy
  build-depends:  Cabal-liquid:assumptions
  other-modules:
    Distribution.Types.VersionInterval.Legacy
