-- Verify refinement type specifications with LiquidHaskell.
--
-- The LiquidHaskell plugin supports a single GHC version at a time, so this
-- project is only expected to build with the GHC that liquidhaskell targets,
-- currently GHC 9.14.  Keep its build products apart from the day-to-day
-- build:
--
--   cabal build --project-file=cabal.liquid.project --builddir=dist-newstyle-liquid all
--
-- or `make liquid`.  Modules are put under verification by listing them in
-- Cabal-liquid/Cabal-liquid.cabal.
import: project-cabal/ghc-options.config
import: project-cabal/ghc-latest.config

packages:
  Cabal-syntax
  Cabal
  Cabal-liquid

tests: False

-- The plugin package is not imported by any module of Cabal-liquid.  This has
-- to be set here rather than in Cabal-liquid.cabal to outrank the
-- -Wunused-packages in project-cabal/ghc-options.config.
package Cabal-liquid
  ghc-options: -Wno-unused-packages
  -- Verification only, so no need to optimise.  This also keeps UNPACK
  -- pragmas out of effect, which LiquidHaskell cannot handle, see
  -- https://github.com/ucsd-progsys/liquidhaskell/issues/2629.
  optimization: False

-- The fixes this project needs, liquidhaskell pull request 2700 above all,
-- are merged upstream but not in a Hackage release yet, so the plugin is
-- taken from the upstream repository.  liquid-fixpoint comes from the same
-- clone, as a submodule, because the version develop needs is unreleased
-- too.  Point at Hackage once a release includes them.
source-repository-package
  type: git
  location: https://github.com/ucsd-progsys/liquidhaskell.git
  tag: 7c809b687388dc837c53b9db29b0a70b7165b716
  subdir: . liquidhaskell-boot liquid-fixpoint

-- liquidhaskell-boot depends on the Cabal library with a bound below the
-- Cabal of this repository, which is why Cabal is among the packages: no
-- Hackage Cabal can share a plan with this Cabal-syntax.  This Cabal in turn
-- asks for a process newer than the one liquidhaskell's ghc dependency pins;
-- that bound is for a macOS segfault fix, not an API, and this project only
-- builds on Linux.
allow-newer: liquidhaskell-boot:Cabal
allow-older: Cabal:process

-- Without this the solver settles on an ancient aeson that does not build.
constraints: aeson >= 2.2
