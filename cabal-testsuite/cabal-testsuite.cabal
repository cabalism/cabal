cabal-version: 3.8
name:          cabal-testsuite
version:       3
copyright:     2003-2026, Cabal Development Team (see AUTHORS file)
license:       BSD-3-Clause
license-file:  LICENSE
author:        Cabal Development Team <cabal-devel@haskell.org>
maintainer:    cabal-devel@haskell.org
homepage:      http://www.haskell.org/cabal/
bug-reports:   https://github.com/haskell/cabal/issues
synopsis:      Test suite for Cabal and cabal-install
description:
  This package defines a shared test suite for Cabal and cabal-install.
category:       Distribution
build-type:     Simple

extra-source-files:
  README.md

source-repository head
  type:     git
  location: https://github.com/haskell/cabal/
  subdir:   cabal-testsuite

common shared
  default-language: GHC2021

  build-depends:
    , base >= 4.11 && < 4.24
    -- this needs to match the in-tree lib:Cabal version
    , Cabal ^>= 3.19.0.0

  ghc-options:
    -Wall
    -Wtabs
    -Wincomplete-uni-patterns
    -Wno-unticked-promoted-constructors


library
  import: shared

  hs-source-dirs: src
  exposed-modules:
    Test.Cabal.CheckArMetadata
    Test.Cabal.DecodeShowBuildInfo
    Test.Cabal.Monad
    Test.Cabal.NeedleHaystack
    Test.Cabal.OutputNormalizer
    Test.Cabal.Plan
    Test.Cabal.Prelude
    Test.Cabal.Run
    Test.Cabal.Script
    Test.Cabal.Server
    Test.Cabal.TestCode
    Test.Cabal.Workdir

  build-depends:
    , Cabal-tests
    , aeson                 ^>= 1.4.2.0 || ^>=1.5.0.0 || ^>= 2.0.0.0 || ^>= 2.1.0.0 || ^>= 2.2.1.0 || ^>= 2.3.0.0
    , async                 ^>= 2.2.1
    , base16-bytestring     ^>= 0.1.1.5 || ^>= 1.0
    , bytestring            ^>= 0.10.0.2 || ^>= 0.11.0.0 || ^>= 0.12.0.0
    , containers            ^>= 0.5.0.0 || ^>= 0.6.0.1 || ^>= 0.7 || ^>= 0.8
    , cryptohash-sha256     ^>= 0.11.101.0
    , directory             ^>= 1.3.1.0
    , exceptions            ^>= 0.10.0
    , filepath              ^>= 1.3.0.1 || ^>= 1.4.0.0 || ^>= 1.5.0.0
    , Glob                  ^>= 0.10.2
    , network-uri            >= 2.6.0.2 && < 2.7
    , network-wait           >= 0.1.2.0 && < 0.5
    , optparse-applicative  ^>= 0.14.3.0 || ^>=0.15.1.0 || ^>=0.16.0.0 || ^>= 0.17.0.0 || ^>= 0.18.1.0 || ^>= 0.19.0.0
    , os-release            ^>= 1.0.2.1
    , process               ^>= 1.2.1.0 || ^>= 1.4.2.0 || ^>= 1.6.1.0
    , regex-base            ^>= 0.94.0.1
    , regex-tdfa            ^>= 1.2.3.1 || ^>=1.3.1.0
    , retry                 ^>= 0.9.1.0
    , array                 ^>= 0.4.0.1 || ^>= 0.5.0.0
    , text                  ^>= 1.2.3.1 || ^>= 2.0.1   || ^>= 2.1
    , transformers          ^>= 0.3.0.0 || ^>= 0.4.2.0 || ^>= 0.5.2.0 || ^>= 0.6.0.2

  if !os(windows)
    build-depends:
      , unix                ^>= 2.6.0.0 || ^>= 2.7.0.0 || ^>= 2.8.0.0
  else
    build-depends:
      , Win32

-- The test driver. It is a test-suite because only a test-suite can have
-- code-generators. The script-env-gen generator is given the GHC options for
-- this component and generates a module with the package databases and
-- package ids from those. The driver runs the test scripts with them.
--
-- Because of that, the dependencies of this component are the packages that
-- a test script can use. If you require an external dependency for a test it
-- must be listed here.
test-suite cabal-tests
  import: shared
  type: exitcode-stdio-1.0
  main-is: cabal-tests.hs
  hs-source-dirs: main
  ghc-options: -threaded -rtsopts
  code-generators: script-env-gen
  build-tool-depends:
    , cabal-testsuite-gen:script-env-gen
    , cabal-testsuite:setup
  build-depends:
    , cabal-testsuite
    -- constraints inherited via lib:cabal-testsuite component
    , async
    , filepath
    , optparse-applicative
    , process
    -- dependencies specific to test:cabal-tests
    , clock                 ^>= 0.7.2 || ^>=0.8
    , directory
    , tasty
    , containers
    -- dependencies of the test scripts only
    , Cabal-syntax
    , Cabal-hooks
    , bytestring
    , exceptions
    , time
    , transformers

  if !os(windows)
    build-depends: unix
  else
    build-depends: Win32

  default-extensions: TypeOperators

-- this executable is needed by lib:cabal-testsuite
executable setup
  import: shared
  main-is: Setup.hs
