cabal-version: 3.0
name:          pkg
version:       0.1.0.0
synopsis:      a library that belongs to the test stanza
description:   The helper library is only requested when test-suites are.
category:      Tests
license:       BSD-3-Clause
author:        cabal
maintainer:    cabal@example.com
build-type:    Simple

library
  default-language: Haskell2010
  hs-source-dirs:   src
  exposed-modules:  Lib
  build-depends:    base

library helper
  default-language: Haskell2010
  stanza:           test
  hs-source-dirs:   helper
  exposed-modules:  Helper
  build-depends:    base

test-suite spec
  default-language: Haskell2010
  type:             exitcode-stdio-1.0
  hs-source-dirs:   tests
  main-is:          Spec.hs
  build-depends:    base, pkg:helper
