cabal-version: 3.0
name:          pkg
version:       0.1.0.0
synopsis:      an executable depending on a library in the test stanza
description:   Depending across a stanza boundary is rejected.
category:      Tests
license:       BSD-3-Clause
author:        cabal
maintainer:    cabal@example.com
build-type:    Simple

library helper
  default-language: Haskell2010
  stanza:           test
  hs-source-dirs:   helper
  exposed-modules:  Helper
  build-depends:    base

executable prog
  default-language: Haskell2010
  hs-source-dirs:   src
  main-is:          Main.hs
  build-depends:    base, pkg:helper
