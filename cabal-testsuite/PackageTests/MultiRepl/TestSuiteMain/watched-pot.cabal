cabal-version: 3.0
name:          watched-pot
version:       0.1.0.0
synopsis:      A library and a test suite to watch together in one GHCi session
build-type:    Simple

library
  exposed-modules:  Pot
  hs-source-dirs:   src
  build-depends:    base
  default-language: Haskell2010

test-suite never-boils
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  build-depends:    base, watched-pot
  default-language: Haskell2010
