cabal-version: 2.4
name: multi
version: 1.0
build-type: Simple

executable foo
  main-is: Foo.hs
  build-depends: base
  default-language: Haskell2010

executable bar
  main-is: Bar.hs
  build-depends: base
  default-language: Haskell2010

test-suite multi-test
  type: exitcode-stdio-1.0
  main-is: Test.hs
  build-depends: base
  default-language: Haskell2010

benchmark multi-bench
  type: exitcode-stdio-1.0
  main-is: Bench.hs
  build-depends: base
  default-language: Haskell2010
