cabal-version:   3.0
name:            dep-Y
version:         2.0
license:         NONE
build-type:      Simple

flag flag-f
    default: True
    manual:  False

flag flag-g
    default: True
    manual:  False

library
    exposed-modules:  Y
    hs-source-dirs:   src
    default-language: Haskell2010

    -- This version can only be built with flag-f off.
    if flag(flag-f)
        build-depends: unknown-dep

    -- Every version can only be built with flag-g off.
    if flag(flag-g)
        build-depends: unknown-dep
