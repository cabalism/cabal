cabal-version: 3.0
name:          pkg
version:       0.1.0.0
synopsis:      a stanza library whose dependency does not exist
description:
  The helper library depends on a package that cannot be resolved. While
  test-suites are not requested the dependency must not be solved for, which is
  what keeps such a library out of, for instance, a bootstrap plan.
category:      Tests
license:       BSD-3-Clause
author:        cabal
maintainer:    cabal@example.com
build-type:    Simple

library
  default-language: Haskell2010
  hs-source-dirs:   src
  exposed-modules:  Lib
  build-depends:    base

library helper
  default-language: Haskell2010
  stanza:           test
  hs-source-dirs:   helper
  exposed-modules:  Helper
  build-depends:    base, this-package-does-not-exist

test-suite spec
  default-language: Haskell2010
  type:             exitcode-stdio-1.0
  hs-source-dirs:   tests
  main-is:          Spec.hs
  build-depends:    base, pkg:helper
