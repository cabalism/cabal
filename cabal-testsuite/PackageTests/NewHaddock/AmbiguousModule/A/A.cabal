cabal-version: 3.6
name:          A
synopsis:      A package whose library and test suite both have a module Foo.
version:       0.0.0

library
  build-depends:    base
  default-language: Haskell2010
  exposed-modules:  Foo
  hs-source-dirs:   src

test-suite t
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  other-modules:    Foo
  build-depends:    base
  default-language: Haskell2010
  hs-source-dirs:   test
