-- Build without optimization.
--
-- GHC spends most of a build optimising, and for an edit-compile loop that
-- work is thrown away: on this project a clean build of lib:cabal-install
-- drops from about 62s to 28s, and combined with the semaphore from about 37s
-- to 16s.
--
-- This is for development only. Anything that runs the built `cabal` for real
-- -- cabal-testsuite, the benchmarks, a release -- wants the optimised build,
-- because an -O0 `cabal` is correspondingly slower at its own work.
--
-- Optimization is part of a component's identity, so switching it re-builds
-- everything. Use a build directory of its own rather than flipping the
-- setting in place:
--
--     cabal build --project-file=cabal.dev.project --builddir=dist-newstyle-dev cabal-install
--
-- `builddir` cannot be set here; it is a command line option only.
optimization: False
